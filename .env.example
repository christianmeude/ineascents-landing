# Landing Page env contract — names only, never real values.
# Local: copy to .env.local with VITE_API_URL=http://127.0.0.1:8080
# Vercel (production landing project): VITE_API_URL=https://ineascents.onrender.com
VITE_API_URL=
# Mobile App base URL for the "Book in App" button (code appends /#/login
# unless the value already contains a hash). Local Flutter web runs pinned
# with `flutter run -d chrome --web-port=62409`, e.g. http://localhost:62409
# Vercel (production): VITE_FRONTEND_URL=https://ineascents-app.vercel.app
VITE_FRONTEND_URL=
